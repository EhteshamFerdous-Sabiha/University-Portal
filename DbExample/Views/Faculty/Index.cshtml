@model List<Faculty>

@{
    ViewData["Title"] = "Faculty List";
}

<!-- Page Header -->
<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold text-blue-900">Faculties</h1>
        <p class="text-gray-500 mt-1">All faculties of AIUB</p>
    </div>
    @if (User.IsInRole("admin") || User.IsInRole("manager"))
    {
        <a asp-controller="Faculty" asp-action="Detail" asp-route-facultyId="0"
           class="btn-primary-tw">
            + New Faculty
        </a>
    }
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert-success mb-6">✅ @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert-error mb-6">❌ @TempData["Error"]</div>
}

<!-- Faculty Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    @foreach (var faculty in Model)
    {
        var gradient = faculty.Title switch
        {
            "FST"  => "from-blue-600 to-blue-800",
            "FE"   => "from-amber-500 to-orange-600",
            "FBA"  => "from-green-600 to-emerald-700",
            "FASS" => "from-purple-600 to-indigo-700",
            _      => "from-gray-500 to-gray-700"
        };
        var icon = faculty.Title switch
        {
            "FST"  => "🔬",
            "FE"   => "⚡",
            "FBA"  => "💼",
            "FASS" => "🎓",
            _      => "🏛️"
        };

        <div class="rounded-2xl overflow-hidden shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
            <div class="bg-gradient-to-br @gradient p-8 text-center text-white">
                <div class="text-5xl mb-3">@icon</div>
                <h2 class="text-2xl font-bold tracking-wide">@faculty.Title</h2>
            </div>
            <div class="bg-white px-4 py-3 flex justify-between items-center">
                @if (faculty.Title == "FST")
                {
                    <a asp-controller="Faculty" asp-action="FstDetails"
                       class="text-sm text-blue-600 font-medium hover:underline">
                        View Members →
                    </a>
                }
                else
                {
                    <span class="text-xs text-gray-400">Faculty</span>
                }

                @if (User.IsInRole("admin") || User.IsInRole("manager"))
                {
                    <div class="flex gap-2">
                        <a asp-controller="Faculty" asp-action="Detail"
                           asp-route-facultyId="@faculty.Id"
                           class="btn-warning-tw">Edit</a>
                        <a asp-controller="Faculty" asp-action="Delete"
                           asp-route-facId="@faculty.Id"
                           onclick="return confirm('Delete this faculty?');"
                           class="btn-danger-tw">Del</a>
                    </div>
                }
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-span-4 text-center py-20 text-gray-400">
            <div class="text-6xl mb-4">🏛️</div>
            <p class="text-lg font-medium">No faculties found.</p>
        </div>
    }
</div>
