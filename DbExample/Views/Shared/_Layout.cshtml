<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - University Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary:  { DEFAULT: '#1e40af', light: '#3b82f6', dark: '#1e3a8a' },
                        accent:   '#f59e0b',
                    }
                }
            }
        }
    </script>
    <style>
        [x-cloak] { display: none; }
        .nav-link-tw { @@apply block px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-150; }
        .nav-link-tw:hover { @@apply bg-blue-700 text-white; }
        .nav-link-active { @@apply bg-blue-800 text-white; }
        .btn-primary-tw  { @@apply inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700 transition-colors shadow; }
        .btn-success-tw  { @@apply inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-green-600 text-white text-sm font-semibold hover:bg-green-700 transition-colors shadow; }
        .btn-warning-tw  { @@apply inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-amber-500 text-white text-xs font-semibold hover:bg-amber-600 transition-colors; }
        .btn-danger-tw   { @@apply inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-red-600 text-white text-xs font-semibold hover:bg-red-700 transition-colors; }
        .btn-secondary-tw{ @@apply inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-200 text-gray-700 text-sm font-semibold hover:bg-gray-300 transition-colors; }
        .form-input-tw   { @@apply w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent; }
        .form-label-tw   { @@apply block text-sm font-medium text-gray-700 mb-1; }
        .card-tw         { @@apply bg-white rounded-2xl shadow-md border border-gray-100 p-6; }
        .table-th        { @@apply px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider; }
        .table-td        { @@apply px-4 py-3 text-sm text-gray-700; }
        .table-tr        { @@apply border-b border-gray-100 hover:bg-blue-50 transition-colors; }
        .alert-success   { @@apply rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm; }
        .alert-error     { @@apply rounded-lg bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm; }
        .validation-msg  { @@apply text-xs text-red-600 mt-1 block; }
        .val-summary     { @@apply rounded-lg bg-red-50 border border-red-300 text-red-700 px-4 py-3 text-sm mb-4; }
        body { @@apply bg-gray-50 text-gray-900 min-h-screen; }
    </style>
</head>
<body class="flex flex-col min-h-screen">

    <!-- NAVBAR -->
    <nav class="bg-blue-900 shadow-lg sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <!-- Brand -->
                <a asp-controller="Home" asp-action="Index"
                   class="flex items-center gap-2 text-white font-bold text-xl tracking-wide">
                    <svg class="w-7 h-7 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zm0 12.5L3.5 11 2 11.82V17c0 1.1 4.48 3 10 3s10-1.9 10-3v-5.18L12 15.5z"/>
                    </svg>
                    University Portal
                </a>

                <!-- Desktop nav -->
                <div class="hidden md:flex items-center gap-1">
                    <a asp-controller="Home" asp-action="Index" class="nav-link-tw text-blue-100">Home</a>
                    <a asp-controller="Faculty" asp-action="Index" class="nav-link-tw text-blue-100">Faculties</a>
                    <a asp-controller="Department" asp-action="Index" class="nav-link-tw text-blue-100">Departments</a>
                    <a asp-controller="FacultyMember" asp-action="Index" class="nav-link-tw text-blue-100">Members</a>
                    <a asp-controller="Student" asp-action="StudentIndex" class="nav-link-tw text-blue-100">Students</a>
                    <a asp-controller="Program" asp-action="Curriculum" class="nav-link-tw text-blue-100">Curriculum</a>
                </div>

                <!-- Auth -->
                <div class="flex items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <span class="hidden sm:block text-sm text-blue-200">
                            👤 @User.Identity.Name
                            @if (User.IsInRole("admin"))
                            {
                                <span class="ml-1 text-xs bg-amber-500 text-white px-2 py-0.5 rounded-full">admin</span>
                            }
                            else if (User.IsInRole("manager"))
                            {
                                <span class="ml-1 text-xs bg-blue-400 text-white px-2 py-0.5 rounded-full">manager</span>
                            }
                        </span>
                        <a asp-controller="Credential" asp-action="LogOut"
                           class="text-sm px-3 py-1.5 rounded-lg bg-red-600 text-white hover:bg-red-700 transition-colors">
                            Logout
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Credential" asp-action="Login"
                           class="text-sm px-3 py-1.5 rounded-lg bg-amber-500 text-white hover:bg-amber-600 transition-colors font-medium">
                            Login
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="bg-blue-900 text-blue-200 text-center text-sm py-4 mt-auto">
        &copy; 2026 University Portal &mdash;
        <a asp-controller="Home" asp-action="Privacy" class="underline hover:text-white">Privacy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
