@model List<DbExample.DTO.DepartmentDTO>

@{
    ViewData["Title"] = "Departments";
}

<!-- Header -->
<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-3xl font-bold text-blue-900">Departments</h1>
        <p class="text-gray-500 mt-1">All university departments</p>
    </div>
    <a asp-action="Detail" asp-controller="Department" asp-route-deptId="-1"
       class="btn-success-tw">
        + New Department
    </a>
</div>

<!-- Table Card -->
<div class="card-tw p-0 overflow-hidden">
    <table class="w-full">
        <thead class="bg-blue-900 text-white">
            <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider">ID</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider">Name</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider">Short Code</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider">Faculty</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var dept in Model)
            {
                <tr class="hover:bg-blue-50 transition-colors">
                    <td class="table-td font-mono text-gray-400">@dept.Id</td>
                    <td class="table-td font-medium text-gray-800">@dept.Name</td>
                    <td class="table-td">
                        <span class="inline-block bg-blue-100 text-blue-700 text-xs font-bold px-2 py-1 rounded">
                            @dept.ShortCode
                        </span>
                    </td>
                    <td class="table-td text-gray-600">@dept.FacultyName</td>
                    <td class="table-td">
                        <div class="flex gap-2">
                            <a asp-action="Detail" asp-controller="Department" asp-route-deptId="@dept.Id"
                               class="btn-warning-tw">Edit</a>
                            <a asp-action="Delete" asp-controller="Department" asp-route-deptId="@dept.Id"
                               onclick="return confirm('Delete this department?');"
                               class="btn-danger-tw">Delete</a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-16 text-gray-400">
                        <div class="text-5xl mb-3">📂</div>
                        <p>No departments yet. <a asp-action="Detail" asp-route-deptId="-1" class="text-blue-600 underline">Add one</a>.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
