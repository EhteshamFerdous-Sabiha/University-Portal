@model LoginModel

@{
    ViewData["Title"] = "Loghttps://localhost:7257/Facultymember/Createin";
    Layout = "_Layout";
}

<div class="min-h-[70vh] flex items-center justify-center">
    <div class="w-full max-w-sm">
        <!-- Logo -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-blue-900 mb-4">
                <svg class="w-8 h-8 text-amber-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zm0 12.5L3.5 11 2 11.82V17c0 1.1 4.48 3 10 3s10-1.9 10-3v-5.18L12 15.5z"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold text-blue-900">AIUB Portal</h1>
            <p class="text-gray-500 text-sm mt-1">Sign in to your account</p>
        </div>

        <div class="card-tw shadow-lg">
            <form action="#" method="post">
                <div asp-validation-summary="All" class="val-summary"></div>

                <div class="mb-4">
                    <label asp-for="Username" class="form-label-tw">Username</label>
                    <input asp-for="Username" class="form-input-tw" placeholder="Enter username" autocomplete="username" />
                    <span asp-validation-for="Username" class="validation-msg"></span>
                </div>

                <div class="mb-6">
                    <label asp-for="Password" class="form-label-tw">Password</label>
                    <input asp-for="Password" type="password" class="form-input-tw" placeholder="Enter password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="validation-msg"></span>
                </div>

                <button type="submit" class="btn-primary-tw w-full justify-center py-2.5 text-base">
                    🔐 Login
                </button>
            </form>

            <p class="text-center text-xs text-gray-400 mt-5">
                Use <strong>admin/admin</strong> or <strong>manager/manager</strong>
            </p>
        </div>
    </div>
</div>
